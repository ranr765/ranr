							{"MXN", "EUR", #date(2026, 6, 29), 41096164, 41096164, 1, "Company B", "Corporate", 41096164},
							{"USD", "AED", #date(2026, 6, 29), 593078, 593078, 1, "Company A", "Bank", 593078},
							{"USD", "AED", #date(2026, 7, 12), 1276485, 1276485, 1, "Company A", "Bank", 1276485},
							{"USD", "AUD", #date(2026, 6, 29), -286731, -286731, -1, "Company B", "Bank", -286731},
