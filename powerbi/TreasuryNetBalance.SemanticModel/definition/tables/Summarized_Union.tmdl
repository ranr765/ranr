table Summarized_Union

	/// Net of the signed amount in each currency's own terms.
	/// Use ONLY on per-currency visuals (do not sum across currencies).
	measure 'Net Amount' = SUM ( 'Summarized_Union'[Countervalue Amount] )
		formatString: #,0

	/// Net converted to CHF — safe to total/compare ACROSS currencies.
	measure 'Net CHF' = SUM ( 'Summarized_Union'[CHF_NEW] )
		formatString: #,0

	measure 'Net Exposure CHF' = ABS ( [Net CHF] )
		formatString: #,0

	/// Running cash position across the period axis.
	measure 'Cumulative Net CHF' =
			CALCULATE (
				[Net CHF],
				FILTER (
					ALLSELECTED ( 'Date'[Period End] ),
					'Date'[Period End] <= MAX ( 'Date'[Period End] )
				)
			)
		formatString: #,0

	measure 'Currencies in Deficit' =
			COUNTROWS (
				FILTER (
					VALUES ( 'Summarized_Union'[Transaction Currency] ),
					[Net CHF] < 0
				)
			)
		formatString: 0

	measure 'Largest Short Currency' =
			VAR ByCcy =
				ADDCOLUMNS (
					VALUES ( 'Summarized_Union'[Transaction Currency] ),
					"@Net", [Net CHF]
				)
			VAR Shorts =
				FILTER ( ByCcy, [@Net] < 0 )
			RETURN
				MAXX ( TOPN ( 1, Shorts, [@Net], ASC ), 'Summarized_Union'[Transaction Currency] )

	column 'Transaction Currency'
		dataType: string
		summarizeBy: none
		sourceColumn: Transaction Currency

	column 'Countervalue Currency'
		dataType: string
		summarizeBy: none
		sourceColumn: Countervalue Currency

	column 'Net Payment due date'
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Net Payment due date

	column 'Countervalue Amount'
		dataType: double
		summarizeBy: sum
		formatString: #,0
		sourceColumn: Countervalue Amount

	column CHF_NEW
		dataType: double
		summarizeBy: sum
		formatString: #,0
		sourceColumn: CHF_NEW

	column DC
		dataType: int64
		summarizeBy: none
		sourceColumn: DC

	column Company
		dataType: string
		summarizeBy: none
		sourceColumn: Company

	column 'Counterparty Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Counterparty Type

	column 'Transaction Amount'
		dataType: double
		summarizeBy: sum
		formatString: #,0
		sourceColumn: Transaction Amount

	partition Summarized_Union = m
		mode: import
		source =
				let
					Source = #table(
						type table [
							#"Transaction Currency" = text,
							#"Countervalue Currency" = text,
							#"Net Payment due date" = date,
							#"Countervalue Amount" = number,
							#"CHF_NEW" = number,
							#"DC" = Int64.Type,
							#"Company" = text,
							#"Counterparty Type" = text,
							#"Transaction Amount" = number
						],
						{
							{"CHF", "EUR", #date(2026, 6, 29), 337141, 337141, 1, "Company A", "Bank", 337141},
							{"CHF", "EUR", #date(2026, 7, 12), -2022392, -2022392, -1, "Company A", "Bank", -2022392},
							{"EUR", "CHF", #date(2026, 6, 29), 356977, 356977, 1, "Company A", "Corporate", 356977},
