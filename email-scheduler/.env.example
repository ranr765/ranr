# Anthropic API Key (required for email summarization)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Email scanner settings
EMAIL_LOOKBACK_DAYS=7         # How many days back to scan
EMAIL_MAX_RESULTS=100         # Max emails to fetch from Gmail
EMAIL_FETCH_BODY_COUNT=30     # How many emails to fetch full body for

# Scheduler cron expression (default: every Monday at 8:00 AM)
EMAIL_CRON_SCHEDULE=0 8 * * 1
