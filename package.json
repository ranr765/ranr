{
  "name": "simple-serve-erp",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=simple-serve-production --local --port 3000",
    "deploy": "wrangler pages deploy public --project-name simple-serve",
    "db:create": "wrangler d1 create simple-serve-production",
    "db:migrate:local": "wrangler d1 migrations apply simple-serve-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply simple-serve-production --remote"
  },
  "devDependencies": {
    "wrangler": "^4.4.0"
  }
}
